# ==============================
# Application
# ==============================
PROJECT_NAME=Treasury API Pilot

# ==============================
# Database
# Use async SQLAlchemy DSN (example for local PostgreSQL + asyncpg)
# ==============================
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/reestr

# ==============================
# Auth / JWT
# IMPORTANT: replace SECRET_KEY in real environments
# ==============================
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ==============================
# CORS
# Comma-separated list (parsed by app/core/config.py)
# ==============================
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://192.168.150.14:5173

# ==============================
# Logging / SQL
# ==============================
LOG_LEVEL=INFO
SQL_ECHO=false

# ==============================
# Upload validation
# Comma-separated lists are supported
# ==============================
UPLOAD_MAX_SIZE_MB=10
UPLOAD_ALLOWED_EXTENSIONS=.pdf,.jpg,.jpeg,.png
UPLOAD_ALLOWED_CONTENT_TYPES=application/pdf,application/x-pdf,image/jpeg,image/pjpeg,image/png

# ==============================
# Workflow gate time policy
# ==============================
APP_TIMEZONE=Europe/Moscow
SUBMIT_CUTOFF_HOUR=11
# Fail-closed regulatory gate: when true, requests whose payment date is not
# covered by the payment calendar (organization without a payment group, or no
# PaymentCalendar row for the date) are routed to manual gate approval
# (PENDING_GATE). Set to false to restore the old fail-open behavior.
GATE_REQUIRE_CALENDAR_COVERAGE=true

# ==============================
# Invoice OCR (evo-ai / Dify-compatible API)
# Empty EVOAI_API_KEY disables OCR (the recognize endpoint returns 503)
# ==============================
EVOAI_API_KEY=
EVOAI_BASE_URL=https://api.evo-ai.ru/v1

# ==============================
# Optional external integrations (scripts)
# Used by scripts/test_ocr.py, not required for app startup
# ==============================
GIGACHAT_CREDENTIALS=
