# ===========================================================================
# Docker Compose environment template (single source of truth for the stack).
#
#   cp .env.docker.example .env.docker
#   # then set a strong SECRET_KEY (see below) before `docker compose up`.
#
# .env.docker is gitignored. Never commit real secrets.
# ===========================================================================

# ---------------------------------------------------------------------------
# PostgreSQL (db service). These three are read by the postgres container AND
# must match the credentials embedded in DATABASE_URL below.
# ---------------------------------------------------------------------------
POSTGRES_USER=treasury_user
POSTGRES_PASSWORD=treasury_pass
POSTGRES_DB=treasury_db

# ---------------------------------------------------------------------------
# Backend (pydantic Settings — app/core/config.py)
# ---------------------------------------------------------------------------
PROJECT_NAME=Treasury API

# Async SQLAlchemy DSN. Host MUST be the compose service name `db`.
# Keep user/password/db in sync with the POSTGRES_* values above.
DATABASE_URL=postgresql+asyncpg://treasury_user:treasury_pass@db:5432/treasury_db

# REQUIRED. Must be >= 32 chars and not a known placeholder, or the app refuses
# to start. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Browser origin(s) allowed by CORS. With the nginx proxy the SPA calls /api
# same-origin (no CORS needed); these matter only for direct backend access.
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:8081,http://127.0.0.1:8081

LOG_LEVEL=INFO
SQL_ECHO=false

# ---------------------------------------------------------------------------
# Workflow time policy (zoneinfo — tzdata is installed in the image)
# ---------------------------------------------------------------------------
APP_TIMEZONE=Europe/Moscow
SUBMIT_CUTOFF_HOUR=11
GATE_REQUIRE_CALENDAR_COVERAGE=true

# ---------------------------------------------------------------------------
# Upload validation
# ---------------------------------------------------------------------------
UPLOAD_MAX_SIZE_MB=10
UPLOAD_ALLOWED_EXTENSIONS=.pdf,.jpg,.jpeg,.png
UPLOAD_ALLOWED_CONTENT_TYPES=application/pdf,application/x-pdf,image/jpeg,image/pjpeg,image/png

# ---------------------------------------------------------------------------
# Background scheduler placement.
# In Docker the scheduler runs as its OWN `scheduler` service, so the API must
# NOT also start it. docker-compose.yml already forces RUN_SCHEDULER_IN_APP=false
# on the backend and scheduler services; leave this false here too.
# ---------------------------------------------------------------------------
RUN_SCHEDULER_IN_APP=false

# Entrypoint flags (also set per-service in docker-compose.yml).
# RUN_MIGRATIONS: backend applies `alembic upgrade head` on start.
# RUN_SEED: run the idempotent seed on start (leave false; seed once as a
#           one-off: `docker compose run --rm -e RUN_SEED=true backend python scripts/seed.py`).
RUN_MIGRATIONS=true
RUN_SEED=false

# ---------------------------------------------------------------------------
# Invoice OCR (evo-ai / Dify-compatible API).
# Empty EVOAI_API_KEY disables OCR (the recognize endpoint returns 503).
# ---------------------------------------------------------------------------
EVOAI_API_KEY=
EVOAI_BASE_URL=https://api.evo-ai.ru/v1
EVOAI_USER=reestr
EVOAI_TIMEOUT_SEC=180
